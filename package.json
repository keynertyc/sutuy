{
  "name": "sutuy",
  "version": "0.1.0",
  "description": "Find, minimize, and replay byte-boundary bugs in streaming consumers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs",
    "examples"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.9.1",
  "license": "MIT",
  "author": "Keyner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keynertyc/sutuy.git"
  },
  "homepage": "https://github.com/keynertyc/sutuy#readme",
  "bugs": {
    "url": "https://github.com/keynertyc/sutuy/issues"
  },
  "keywords": [
    "streams",
    "testing",
    "sse",
    "ndjson",
    "utf8",
    "fuzzing",
    "shrinking",
    "typescript"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "demo": "node examples/demo.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm coverage && pnpm build && pnpm check:docs && pnpm demo && pnpm check:package",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
